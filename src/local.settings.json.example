{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "POLL_SCHEDULE": "0 */2 * * * *",

    "//SEED_MODE": "true records items as seen and sends nothing. Run one cycle like this against a fresh dedupe table, or the first real run alerts on everything at once.",
    "SEED_MODE": "false",

    "NOTIFY_PROVIDER": "ntfy",
    "NTFY_TOPIC": "replace-with-a-long-random-string",

    "IMAP_HOST": "imap.gmail.com",
    "IMAP_USER": "you@gmail.com",
    "IMAP_PASSWORD": "<gmail app password - NOT your account password>",
    "IMAP_SENDERS": "walmart.com,bazaarvoice.com",
    "//IMAP_BACKFILL_DAYS": "How far back the very first poll looks. Later polls read only messages newer than the stored UID marker.",
    "IMAP_BACKFILL_DAYS": "1",
    "IMAP_LOOKBACK": "25",

    "INGEST_TOKEN": "another-long-random-string"
  }
}
