{
  "manifest_version": 3,
  "name": "Reviewer Item Relay",
  "version": "2.0.0",
  "description": "Relays items from your own signed-in reviewer page to the notifier running on this machine.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.walmart.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/reviews/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Reviewer Item Relay"
  }
}
