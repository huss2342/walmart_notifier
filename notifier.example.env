# Copy to notifier.env and fill in. notifier.env is gitignored.

# --- push channel -----------------------------------------------------------
# Reviewer Alerts Discord feeds: receive ALL captured items before personal
# rules, classify by product evidence, and durably queue the tiered destinations.
# Bot credentials stay in ignored data/discord_bridge/local.env (not the extension).
# Existing data/discord_bridge/server.json supplies the private channel IDs.
# NOTIFY_PROVIDER=discord
# DISCORD_LIVE=true
# DISCORD_QUEUE_PATH=data/discord_bridge/collector.sqlite3
# DISCORD_STATE_PATH=data/discord_bridge/server.json
# Optional personal greetings, using private native join events from #audit.
# Requires managed #greeting and source configuration verified by the live audit.
# DISCORD_WELCOME_ENABLED=false
# DISCORD_WELCOME_PATH=data/discord_bridge/welcome.sqlite3
# Optional colorful Starter/Pro activation and Pro upgrade cards in #greeting.
# Requires Server Members Intent enabled for this bot in Discord Developer Portal.
# DISCORD_MEMBERSHIP_ENABLED=false
# Pro-only /request commands and DM-only item matches. Bind/audit #item-requests
# and explicitly register the guild command before enabling. No public endpoint.
# DISCORD_REQUESTS_ENABLED=false
# DISCORD_MEMBERSHIP_PATH=data/discord_bridge/membership.sqlite3
# With DISCORD_LIVE=false, intake queues but never sends. Use a separate queue
# path for test data so synthetic observations never enter the live feeds.
# Starter: positive value below $40, +5 minutes. Pro: all values, immediate.
# Free: every captured item, including unavailable, +24 hours, historical.
# Discord ignores personal min-value/keyword rules. Diagnostic notices are
# restricted to private #collector-health. Billing remains a separate setting.

# ntfy push delivery needs no account. The public ntfy.sh service currently
# allows 250 published messages per day. Install the ntfy app on your phone,
# then subscribe to this exact topic. The topic name IS the password: anyone
# who knows it can read your alerts, so make it long and random.
#   python -c "import secrets; print(secrets.token_hex(16))"
NTFY_TOPIC=change-me-to-a-long-random-string

# Optional ntfy server (default shown).
# NTFY_SERVER=https://ntfy.sh

# ntfy.sh email forwarding requires a verified account/email address and an
# access token for that account. With NTFY_EMAIL but no NTFY_TOKEN, this code
# deliberately sends push-only and exposes a diagnostic in /health and Options.
# With both settings, ntfy requests push and email delivery for each alert.
# NTFY_TOKEN=tk_your_account_access_token
# NTFY_EMAIL=you@example.com

# Alternatives: pushover (one-time $5, bypasses Do Not Disturb) or telegram.
# NOTIFY_PROVIDER=pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER_KEY=

# Telegram is free. Create a private bot with the verified @BotFather, open the
# bot, press Start, and send it a message before retrieving your private chat ID.
# Once running, use /help, /status, /filters, and /test in that private chat.
# Commands still work privately when alerts go to a group. /test sends a labeled
# test to the selected alert destination, bypassing rules and dedupe.
# To notify another person too, make a private Telegram group with them and the
# bot, then send /usehere in that group from this TELEGRAM_CHAT_ID account.
# Send /useprivate in your original bot chat to move alerts back.
# NOTIFY_PROVIDER=telegram
# TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
# TELEGRAM_CHAT_ID=123456789

# --- behaviour --------------------------------------------------------------

# true records everything as seen and sends nothing. Run once like this on a
# fresh install, or the first page relayed alerts on ~30 items at once.
SEED_MODE=false

# Optional shared secret. Native runs bind to loopback. The supplied Compose
# service uses a narrowly scoped container-only exception and publishes its
# port on host loopback, so Docker does not require a token either. A token is
# still useful if you do not trust other programs on this machine.
# INGEST_TOKEN=

# Keep the default unless a token-protected LAN listener is intentional.
# compose.yaml overrides this inside its private container network.
# BIND_HOST=127.0.0.1

# Where the dedupe file lives. Default: data/seen.json next to this file.
# STATE_PATH=

# PORT=8787

# --- silence detection ------------------------------------------------------
# Alert if no reviewer page has been relayed for this many hours. Every failure
# so far has been browser-side (tab closed, tab navigated away, a bot check),
# and from the notifier's side all of them look the same as "nothing matched".
# One delivered alert per outage; failed delivery retries every five minutes.
# It re-arms when relays resume. Default 2 hours.
# STALE_RELAY_HOURS=2

# --- how long items are remembered ------------------------------------------
# An item is not alerted again while it is remembered. This used to be a row
# count (20,000), which meant the real window was whatever the churn rate
# implied -- about three days -- so an item still listed could re-alert.
# Default 60 days. The portal yields roughly 3,000-10,000 new ids a day.
# RETENTION_DAYS=60
