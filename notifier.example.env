# Copy to notifier.env and fill in. notifier.env is gitignored.

# --- push channel -----------------------------------------------------------
# ntfy is free and needs no account. Install the ntfy app on your phone, then
# subscribe to this exact topic. The topic name IS the password: anyone who
# knows it can read your alerts, so make it long and random.
#   python -c "import secrets; print(secrets.token_hex(16))"
NTFY_TOPIC=change-me-to-a-long-random-string

# ntfy also delivers to email if you would rather have that. Uncomment and set
# your address; alerts then arrive as mail instead of a push.
# NTFY_EMAIL=you@example.com

# Alternatives: pushover (one-time $5, bypasses Do Not Disturb) or telegram.
# NOTIFY_PROVIDER=pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER_KEY=

# --- behaviour --------------------------------------------------------------

# true records everything as seen and sends nothing. Run once like this on a
# fresh install, or the first page relayed alerts on ~30 items at once.
SEED_MODE=false

# Optional shared secret. The server only listens on loopback, so this only
# matters if you do not trust other programs on this machine.
# INGEST_TOKEN=

# Where the dedupe file lives. Default: data/seen.json next to this file.
# STATE_PATH=

# PORT=8787
